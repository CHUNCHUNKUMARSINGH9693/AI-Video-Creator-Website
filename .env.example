# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=ai_video_creator

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_ai_video_creator_2026_x98f23ba
JWT_EXPIRES_IN=7d

# AI Video Provider Configuration
# Supported providers: demo, replicate, runway, openai, luma
AI_VIDEO_PROVIDER=demo
AI_VIDEO_API_KEY=

# Storage Provider Configuration
# Supported providers: local, s3
STORAGE_PROVIDER=local
STORAGE_PATH=uploads

# Video Processing (FFmpeg)
# Default is internal bundled ffmpeg (via @ffmpeg-installer/ffmpeg)
FFMPEG_PATH=

# Social Publishing APIs (Optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Text-to-Speech / Audio (Optional external providers)
ELEVENLABS_API_KEY=
